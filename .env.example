# Copy to .env.local and fill in. Never commit real values.

# Supabase Postgres (Project Settings → Database → Connection string)
DATABASE_URL="postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Storage (Project Settings → API)
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""   # server only, never NEXT_PUBLIC_
SUPABASE_BUCKET="brand-assets"

# App
SESSION_SECRET=""              # 32+ random bytes: openssl rand -base64 32
CRON_SECRET=""                 # random string; Vercel Cron sends it as a Bearer token
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial admin (used ONLY by the seed script, and only when no admin exists yet)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
